# 前端镜像：Node 构建 → nginx 托管静态文件并反代 /api 到后端
# 构建上下文 = trval-h5 仓库根目录
FROM node:22-alpine AS build
WORKDIR /web
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=build /web/dist /usr/share/nginx/html
# nginx 配置从前端仓库带过来（build context 是 trval-h5，跨目录 COPY 取不到后端 deploy/）
COPY --from=build /web/nginx.deploy.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
